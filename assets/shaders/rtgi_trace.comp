layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D uDepthTexture;
layout(set = 1, binding = 1) uniform sampler2D uNormalAoTexture;
layout(set = 1, binding = 2) uniform sampler2D uMaterialAuxTexture;
layout(set = 1, binding = 3) uniform sampler2D uBlueNoiseTexture;
layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D uDiffuseRadianceHitDistance;
layout(set = 1, binding = 5, rg32ui) uniform writeonly uimage2D uValidation;
layout(std430, set = 1, binding = 6) readonly buffer TerrainRayTracingHitDataTable {
    TerrainRayTracingGpuInstance instances[];
} uTerrainHitData;
layout(set = 1, binding = 7) uniform sampler2DArray uTerrainAlbedo;
layout(set = 1, binding = 11) uniform sampler2DArray uTerrainNormal;
layout(set = 1, binding = 12) uniform sampler2DArray uTerrainSpecular;
layout(set = 1, binding = 13) uniform sampler2D uGrassColormap;
layout(set = 1, binding = 14) uniform sampler2D uFoliageColormap;
layout(set = 1, binding = 15) uniform sampler2D uSkyCapture;
layout(set = 1, binding = 17) uniform sampler2D uVoxelLightTexture;
layout(std140, set = 1, binding = 16) uniform RtgiSecondaryLightingParams {
    vec4 sunDirectionAndVisibility;
    vec4 moonDirectionAndVisibility;
    vec4 sunRadiance;
    vec4 moonRadiance;
    vec4 skyAmbientRadiance;
    vec4 traceAndEmissionScales;
    vec4 terrainLightScales;
    uvec4 flags;
} uSecondaryLighting;

layout(push_constant) uniform RtgiTracePushConstants {
    mat4 inverseViewProjection;
    vec4 cameraPositionAndMaxDistance;
    vec4 renderExtentAndBias;
    uvec4 frameMaskAndFlags;
    uvec4 materialGeometryCounts;
} pc;

struct RtgiSecondarySurface {
    vec3 albedo;
    vec3 normal;
    vec3 geometricNormal;
    vec3 emission;
    vec3 specularF0;
    float specularF90;
    float perceptualRoughness;
    float metalness;
    float ao;
    float skyVisibility;
    // Retained in the hit-surface ABI for voxel validation; analytic GpuLights own local radiance.
    float blockLight;
};

const float RTGI_METALLIC_DIFFUSE_TRANSPORT_FLOOR = 0.35;
// The sky capture contains a high-radiance solar disk. A single diffuse ray
// occasionally landing on that tiny disk must not become a screen-space
// firefly, so keep the raw one-spp signal within the normal scene range.
const float RTGI_RADIANCE_FIREFLY_CLAMP = 8.0;

bool rtgiFinite(float value) {
    return !isnan(value) && !isinf(value);
}

bool rtgiFinite(vec2 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

bool rtgiFinite(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

void rtgiSolarAngularMasks(vec3 worldDirection, out float solarLobeMask, out float solarCoreMask) {
    vec3 sunDirection = normalize(uSecondaryLighting.sunDirectionAndVisibility.xyz);
    float visibility = clamp(uSecondaryLighting.sunDirectionAndVisibility.w, 0.0, 1.0) *
                       smoothstep(-0.05, 0.08, sunDirection.y);
    float angle = acos(clamp(dot(normalize(worldDirection), sunDirection), -1.0, 1.0));
    solarLobeMask = (1.0 - smoothstep(0.018, 0.180, angle)) * visibility;
    solarCoreMask = (1.0 - smoothstep(0.000, 0.070, angle)) * visibility;
}

vec3 rtgiSuppressSolarSkyLobe(vec3 skyRadiance, vec3 worldDirection) {
    // The deferred sky composite removes this captured solar lobe and draws the
    // procedural sun separately. Apply the same separation to GI misses so a
    // one-spp ray cannot turn the tiny solar disk into a bright indirect-light point.
    float solarLobeMask;
    float solarCoreMask;
    rtgiSolarAngularMasks(worldDirection, solarLobeMask, solarCoreMask);
    skyRadiance *= (1.0 - solarLobeMask * 0.94) * (1.0 - solarCoreMask * 0.92);
    float skyLuminance = dot(skyRadiance, vec3(0.2126, 0.7152, 0.0722));
    skyRadiance *= min(1.0, mix(18.0, 1.5, solarCoreMask) / max(skyLuminance, 1.0e-5));
    return max(skyRadiance, vec3(0.0));
}

void rtgiWriteResult(ivec2 texel, vec3 radiance, float hitDistance, uint classification, uint candidateCount,
                     uint confirmedCount, uint hitIdentityHash) {
    if (!rtgiFinite(radiance) || !rtgiFinite(hitDistance) ||
        any(lessThan(radiance, vec3(0.0))) ||
        hitDistance < 0.0) {
        imageStore(uDiffuseRadianceHitDistance, texel, vec4(0.0));
        imageStore(uValidation, texel,
                   uvec4(rtgiTraceValidationWord(RTGI_TRACE_CLASS_NON_FINITE, candidateCount, confirmedCount),
                         0u, 0u, 0u));
        return;
    }
    vec3 preExposedRadiance = radiance * uSecondaryLighting.traceAndEmissionScales.w;
    if (!rtgiFinite(preExposedRadiance)) {
        imageStore(uDiffuseRadianceHitDistance, texel, vec4(0.0));
        imageStore(uValidation, texel,
                   uvec4(rtgiTraceValidationWord(RTGI_TRACE_CLASS_NON_FINITE, candidateCount, confirmedCount),
                         0u, 0u, 0u));
        return;
    }
    preExposedRadiance = min(preExposedRadiance,
                             vec3(RTGI_RADIANCE_FIREFLY_CLAMP) * uSecondaryLighting.traceAndEmissionScales.w);
    imageStore(uDiffuseRadianceHitDistance, texel,
               vec4(min(preExposedRadiance, vec3(RTGI_NRD_FP16_MAX)), min(hitDistance, RTGI_NRD_FP16_MAX)));
    imageStore(uValidation, texel,
               uvec4(rtgiTraceValidationWord(classification, candidateCount, confirmedCount),
                     hitIdentityHash, 0u, 0u));
}

bool rtgiReconstructWorldPosition(vec2 screenUv, float depth, out vec3 worldPosition) {
    vec2 clipUv = rhiScreenUvToClipUv(screenUv);
    vec4 worldPositionH = pc.inverseViewProjection * vec4(clipUv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    if (abs(worldPositionH.w) <= 1.0e-7) {
        worldPosition = vec3(0.0);
        return false;
    }
    worldPosition = worldPositionH.xyz / worldPositionH.w;
    return rtgiFinite(worldPosition);
}

float rtgiOriginBias(vec3 position, vec3 normal, vec3 direction) {
    float positionScale = max(max(abs(position.x), max(abs(position.y), abs(position.z))), 1.0);
    float floatingPointBias = positionScale * 9.5367431640625e-7;
    float angularScale = 1.0 / max(abs(dot(normal, direction)), 0.25);
    return max(max(pc.renderExtentAndBias.z, RTGI_MINIMUM_RAY_ORIGIN_BIAS), floatingPointBias) * angularScale;
}

// Moves a ray origin to the geometric side selected by its outgoing direction.
// This keeps visibility and primary rays outside the source surface for both
// hemispheres, matching the RT surface-offset contract used by Caustica.
vec3 rtgiOffsetSurfaceOrigin(vec3 position, vec3 geometricNormal, vec3 outgoingDirection, float bias) {
    float side = dot(geometricNormal, outgoingDirection) < 0.0 ? -1.0 : 1.0;
    return position + geometricNormal * (side * bias);
}

vec3 rtgiVoxelGeometricNormal(vec3 shadingNormal) {
    vec3 magnitude = abs(shadingNormal);
    if (magnitude.x >= magnitude.y && magnitude.x >= magnitude.z) {
        return vec3(shadingNormal.x < 0.0 ? -1.0 : 1.0, 0.0, 0.0);
    }
    if (magnitude.y >= magnitude.z) {
        return vec3(0.0, shadingNormal.y < 0.0 ? -1.0 : 1.0, 0.0);
    }
    return vec3(0.0, 0.0, shadingNormal.z < 0.0 ? -1.0 : 1.0);
}

float rtgiConeWidth(float pixelWorldFootprint, float rayDistance, float primarySurfaceDistance) {
    return pixelWorldFootprint *
           (1.0 + rayDistance / max(primarySurfaceDistance, pixelWorldFootprint));
}

bool rtgiCandidateAlphaPasses(uint customIndex, uint geometryIndex, uint primitiveIndex, vec2 barycentrics,
                              float coneWidth, out float sampledOpacity, out float sampledLod,
                              out uint stableMaterialId, out uint stableGeometryId) {
    sampledOpacity = 0.0;
    sampledLod = 0.0;
    stableMaterialId = 0u;
    stableGeometryId = 0u;
    if (customIndex >= pc.frameMaskAndFlags.z) {
        return false;
    }
    if (staticMeshRayQueryInstancePresent(customIndex, pc.frameMaskAndFlags.z)) {
        return staticMeshRayQueryCandidateAlphaPasses(
            customIndex, geometryIndex, primitiveIndex, barycentrics, coneWidth, pc.frameMaskAndFlags.z,
            pc.materialGeometryCounts.x, pc.materialGeometryCounts.y, sampledOpacity, sampledLod,
            stableMaterialId, stableGeometryId);
    }
    return terrainRayQueryCandidateAlphaPasses(
        uTerrainHitData.instances[customIndex], geometryIndex, primitiveIndex, barycentrics, coneWidth,
        pc.renderExtentAndBias.w, uTerrainAlbedo, sampledOpacity, sampledLod);
}

bool rtgiTraceVisibility(vec3 surfacePosition, vec3 normal, vec3 direction, float maximumDistance,
                         float endpointExclusionDistance, float coneWidth, out float visibility) {
    visibility = 0.0;
    float directionLengthSquared = dot(direction, direction);
    if (!rtgiFinite(surfacePosition) || !rtgiFinite(normal) || !rtgiFinite(direction) ||
        directionLengthSquared <= 1.0e-12 || !rtgiFinite(maximumDistance) || maximumDistance <= 0.0 ||
        !rtgiFinite(endpointExclusionDistance) || endpointExclusionDistance < 0.0 ||
        !rtgiFinite(coneWidth) || coneWidth <= 0.0) {
        return false;
    }
    vec3 unitDirection = direction * inversesqrt(directionLengthSquared);
    float originBias = rtgiOriginBias(surfacePosition, normal, unitDirection);
    vec3 originOffset = rtgiOffsetSurfaceOrigin(vec3(0.0), normal, unitDirection, originBias);
    float rayMinimum = max(originBias * 0.25, 1.0e-4);
    float endpointDistance = maximumDistance - dot(originOffset, unitDirection);
    float rayMaximum = endpointDistance - rayMinimum;
    if (rayMaximum <= rayMinimum) {
        visibility = 1.0;
        return true;
    }
    vec3 rayOrigin = surfacePosition + originOffset;

    rayQueryEXT query;
    rayQueryInitializeEXT(query, globalBindlessSceneTlas, gl_RayFlagsTerminateOnFirstHitEXT,
                          pc.frameMaskAndFlags.w, rayOrigin, rayMinimum, unitDirection, rayMaximum);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        float candidateDistance = rayQueryGetIntersectionTEXT(query, false);
        // Point-light source geometry lies at the ray endpoint. Exclude only
        // its authored local radius so it cannot block its own GI transport.
        if (candidateDistance >= endpointDistance - endpointExclusionDistance) {
            continue;
        }
        float sampledOpacity;
        float sampledLod;
        uint stableMaterialId;
        uint stableGeometryId;
        if (rtgiCandidateAlphaPasses(
                rayQueryGetIntersectionInstanceCustomIndexEXT(query, false),
                rayQueryGetIntersectionGeometryIndexEXT(query, false),
                rayQueryGetIntersectionPrimitiveIndexEXT(query, false),
                rayQueryGetIntersectionBarycentricsEXT(query, false), coneWidth, sampledOpacity,
                sampledLod, stableMaterialId, stableGeometryId)) {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    visibility = rayQueryGetIntersectionTypeEXT(query, true) ==
                         gl_RayQueryCommittedIntersectionTriangleEXT
                     ? 0.0
                     : 1.0;
    return true;
}

// A primary ray miss is only a sky sample when the surface can actually see
// the sky. The voxel sky-light channel is a stable coarse visibility prior;
// the TLAS query rejects false sky hits caused by an incomplete/stale BLAS.
bool rtgiPrimarySkyVisibility(vec3 surfacePosition, vec3 geometricNormal, float pixelWorldFootprint,
                              ivec2 texel, out float visibility) {
    visibility = 0.0;
    float skyLight = clamp(texelFetch(uVoxelLightTexture, texel, 0).r, 0.0, 1.0);
    float skyLightMask = skyLight * skyLight * skyLight;
    if (skyLightMask <= 1.0e-4) {
        return true;
    }
    vec3 skyDirection = vec3(0.0, 1.0, 0.0);
    if (dot(geometricNormal, skyDirection) > 0.0) {
        skyDirection = normalize(skyDirection + geometricNormal);
    }
    float geometryVisibility = 0.0;
    if (!rtgiTraceVisibility(surfacePosition, geometricNormal, skyDirection,
                              uSecondaryLighting.traceAndEmissionScales.x, 0.0, pixelWorldFootprint,
                              geometryVisibility)) {
        return false;
    }
    visibility = skyLightMask * geometryVisibility;
    return true;
}

vec3 rtgiDiffuseTransportAlbedo(RtgiSecondarySurface surface) {
    float transportWeight = mix(1.0, RTGI_METALLIC_DIFFUSE_TRANSPORT_FLOOR,
                                clamp(surface.metalness, 0.0, 1.0));
    return surface.albedo * transportWeight;
}

bool rtgiEvaluateDirectionalSurface(RtgiSecondarySurface surface, vec3 viewDirection, vec3 lightDirection,
                                    vec3 incidentRadiance, out vec3 radiance) {
    radiance = vec3(0.0);
    float lightLengthSquared = dot(lightDirection, lightDirection);
    if (!rtgiFinite(viewDirection) || !rtgiFinite(lightDirection) || !rtgiFinite(incidentRadiance) ||
        lightLengthSquared <= 1.0e-12) {
        return false;
    }
    vec3 unitLightDirection = lightDirection * inversesqrt(lightLengthSquared);
    float nDotL = max(dot(surface.normal, unitLightDirection), 0.0);
    if (nDotL <= 0.0 || all(lessThanEqual(incidentRadiance, vec3(0.0)))) {
        return true;
    }
    vec3 halfVector = viewDirection + unitLightDirection;
    float halfLengthSquared = dot(halfVector, halfVector);
    if (halfLengthSquared <= 1.0e-12) {
        return false;
    }
    vec3 halfDirection = halfVector * inversesqrt(halfLengthSquared);
    float lDotH = max(dot(unitLightDirection, halfDirection), 0.0);
    vec3 fresnel = pbrFresnelSchlick(lDotH, surface.specularF0, surface.specularF90);
    vec3 diffuseWeight = pbrDiffuseWeight(fresnel, surface.metalness) +
                         vec3(RTGI_METALLIC_DIFFUSE_TRANSPORT_FLOOR * clamp(surface.metalness, 0.0, 1.0));
    radiance = diffuseWeight * pbrLambertDiffuse(surface.albedo) * nDotL * incidentRadiance;
    return rtgiFinite(radiance);
}

bool rtgiAccumulateCelestial(RtgiSecondarySurface surface, vec3 surfacePosition, vec3 viewDirection,
                             vec4 directionAndVisibility, vec3 incidentRadiance, float coneWidth,
                             inout vec3 radiance) {
    if (directionAndVisibility.w <= 0.0 || all(lessThanEqual(incidentRadiance, vec3(0.0)))) {
        return true;
    }
    vec3 directRadiance;
    if (!rtgiEvaluateDirectionalSurface(surface, viewDirection, directionAndVisibility.xyz,
                                        incidentRadiance, directRadiance)) {
        return false;
    }
    if (all(lessThanEqual(directRadiance, vec3(0.0)))) {
        return true;
    }
    float shadowVisibility;
    if (!rtgiTraceVisibility(surfacePosition, surface.geometricNormal, directionAndVisibility.xyz,
                             uSecondaryLighting.traceAndEmissionScales.x, 0.0, coneWidth, shadowVisibility)) {
        return false;
    }
    radiance += directRadiance * shadowVisibility;
    return true;
}

bool rtgiLightRayDirection(GpuLight light, vec3 cameraRelativeSurface, out vec3 direction,
                           out float maximumDistance) {
    direction = vec3(0.0);
    maximumDistance = 0.0;
    if (gpuLightType(light) == GPU_LIGHT_TYPE_DIRECTIONAL) {
        direction = -light.direction.xyz;
        maximumDistance = uSecondaryLighting.traceAndEmissionScales.x;
    } else {
        vec3 surfaceToLight = light.positionAndRange.xyz - cameraRelativeSurface;
        float distanceSquared = dot(surfaceToLight, surfaceToLight);
        if (!rtgiFinite(surfaceToLight) || distanceSquared <= 1.0e-12) {
            return false;
        }
        maximumDistance = sqrt(distanceSquared);
        direction = surfaceToLight / maximumDistance;
    }
    return rtgiFinite(direction) && rtgiFinite(maximumDistance) && maximumDistance > 0.0;
}

bool rtgiLightVisibility(GpuLight light, vec3 surfacePosition, vec3 cameraRelativeSurface,
                         vec3 originNormal, float coneWidth, out float visibility) {
    visibility = 0.0;
    uint policy = gpuLightShadowPolicy(light);
    if (policy == GPU_LIGHT_SHADOW_NONE) {
        visibility = 1.0;
        return gpuLightShadowIndex(light) == GPU_LIGHT_INVALID_RESOURCE_INDEX;
    }
    bool rasterPolicy = policy == GPU_LIGHT_SHADOW_RASTER_DYNAMIC || policy == GPU_LIGHT_SHADOW_RASTER_CACHED;
    if ((!rasterPolicy && policy != GPU_LIGHT_SHADOW_RAY_QUERY) ||
        (rasterPolicy && gpuLightShadowIndex(light) == GPU_LIGHT_INVALID_RESOURCE_INDEX) ||
        (policy == GPU_LIGHT_SHADOW_RAY_QUERY &&
         gpuLightShadowIndex(light) != GPU_LIGHT_INVALID_RESOURCE_INDEX)) {
        return false;
    }
    // RTGI traces local-light visibility against the same TLAS as its bounce ray.
    // Raster policies identify the direct-light cache and do not change this path.
    vec3 direction;
    float maximumDistance;
    float endpointExclusionDistance = gpuLightType(light) == GPU_LIGHT_TYPE_POINT
                                          ? gpuLightPointSelfShadowRadius(light)
                                          : 0.0;
    return rtgiLightRayDirection(light, cameraRelativeSurface, direction, maximumDistance) &&
           rtgiTraceVisibility(surfacePosition, originNormal, direction, maximumDistance, endpointExclusionDistance,
                               coneWidth, visibility);
}

bool rtgiAccumulateGpuLight(GpuLight light, RtgiSecondarySurface surface, vec3 surfacePosition,
                            vec3 cameraRelativeSurface, vec3 viewDirection, float coneWidth,
                            inout vec3 radiance) {
    float nDotV = max(dot(surface.normal, viewDirection), 0.0);
    GpuLightSurfaceContribution contribution = evaluateGpuLight(
        light, cameraRelativeSurface, surface.normal, viewDirection, surface.specularF0,
        surface.specularF90, nDotV,
        pbrPerceptualRoughnessToAlphaSquared(surface.perceptualRoughness));
    if (all(lessThanEqual(contribution.diffuse, vec3(0.0)))) {
        return true;
    }
    float shadowVisibility;
    if (!rtgiLightVisibility(light, surfacePosition, cameraRelativeSurface,
                             surface.geometricNormal, coneWidth,
                             shadowVisibility)) {
        // An optional local-light shadow resource must not erase celestial or
        // sky radiance already accumulated for this secondary hit.
        return true;
    }
    radiance += rtgiDiffuseTransportAlbedo(surface) * contribution.diffuse * shadowVisibility;
    return rtgiFinite(radiance);
}

bool rtgiAccumulateWorldLights(RtgiSecondarySurface surface, vec3 surfacePosition,
                               vec3 cameraRelativeSurface, vec3 viewDirection, float coneWidth,
                               inout vec3 radiance) {
    if (uClusterStats[CLUSTER_STATS_BUILD_ERROR] != 0u ||
        uClusterStats[CLUSTER_STATS_CONTRACT_VERSION] != GPU_LIGHT_CONTRACT_VERSION ||
        !worldLightGridHeaderValid()) {
        // Local lights are optional secondary transport. Preserve RTGI when
        // their frame-local product is unavailable or empty.
        return true;
    }
    uint lightCount = uClusterStats[CLUSTER_STATS_LIGHT_COUNT];
    uint globalLightCount = uWorldLightGrid.countsAndVersion.z;
    for (uint listIndex = 0u; listIndex < globalLightCount; ++listIndex) {
        uint lightIndex = uWorldLightIndices[listIndex];
        if (lightIndex < lightCount) {
            rtgiAccumulateGpuLight(uClusterLights[lightIndex], surface, surfacePosition,
                                   cameraRelativeSurface, viewDirection, coneWidth, radiance);
        }
    }

    uvec2 cellRange;
    if (!worldLightGridCellRange(cameraRelativeSurface, cellRange)) {
        return true;
    }
    for (uint listIndex = 0u; listIndex < cellRange.y; ++listIndex) {
        uint lightIndex = uWorldLightIndices[cellRange.x + listIndex];
        if (lightIndex < lightCount) {
            rtgiAccumulateGpuLight(uClusterLights[lightIndex], surface, surfacePosition,
                                   cameraRelativeSurface, viewDirection, coneWidth, radiance);
        }
    }
    return true;
}

bool rtgiAccumulateSkyAmbient(RtgiSecondarySurface surface, vec3 surfacePosition, float coneWidth,
                              float originSkyPrior, inout vec3 radiance) {
    float skyVisibility = clamp(surface.skyVisibility, 0.0, 1.0) * originSkyPrior;
    if (skyVisibility <= 0.0 || all(lessThanEqual(uSecondaryLighting.skyAmbientRadiance.rgb, vec3(0.0)))) {
        return true;
    }
    vec3 skyDirection = surface.normal + vec3(0.0, 1.0, 0.0);
    float directionLengthSquared = dot(skyDirection, skyDirection);
    if (directionLengthSquared <= 1.0e-12) {
        return true;
    }
    skyDirection *= inversesqrt(directionLengthSquared);
    if (dot(surface.normal, skyDirection) <= 0.0) {
        return true;
    }
    float visibility;
    if (!rtgiTraceVisibility(surfacePosition, surface.geometricNormal, skyDirection,
                             uSecondaryLighting.traceAndEmissionScales.x, 0.0, coneWidth, visibility)) {
        return false;
    }
    radiance += rtgiDiffuseTransportAlbedo(surface) * uSecondaryLighting.skyAmbientRadiance.rgb * surface.ao *
                skyVisibility * visibility;
    return rtgiFinite(radiance);
}

bool rtgiShadeSecondarySurface(RtgiSecondarySurface surface, vec3 surfacePosition,
                               vec3 incomingRayDirection, float coneWidth, float originSkyPrior,
                               out vec3 radiance) {
    radiance = vec3(0.0);
    vec3 viewDirection = -incomingRayDirection;
    if (!rtgiFinite(surface.albedo) || !rtgiFinite(surface.normal) || !rtgiFinite(surface.geometricNormal) ||
        !rtgiFinite(surface.emission) ||
        !rtgiFinite(surface.specularF0) || !rtgiFinite(surface.specularF90) ||
        !rtgiFinite(surface.perceptualRoughness) || !rtgiFinite(surface.metalness) ||
        !rtgiFinite(surface.ao) || !rtgiFinite(surface.skyVisibility) || !rtgiFinite(surface.blockLight) ||
        !rtgiFinite(viewDirection)) {
        return false;
    }
    radiance = surface.emission;
    // Celestial radiance is gated by two conservative voxel sky-light priors:
    // the hit surface's vertex sky light (a surface that cannot see the sky
    // cannot receive direct sun or moon radiance) and the ray-origin
    // surface's sky light (a fully enclosed origin cannot legally receive
    // sun, moon, or sky-ambient energy in one bounce). Together they reject
    // shadow rays and GI rays that thread through greedy-mesh T-junction and
    // corner seam cracks. Emissive and local lights are unaffected; static
    // mesh hits publish skyVisibility 1; the miss path
    // applies the origin prior through rtgiPrimarySkyVisibility.
    float celestialMask = clamp(surface.skyVisibility, 0.0, 1.0);
    celestialMask *= celestialMask * celestialMask;
    celestialMask *= originSkyPrior;
    if (!rtgiAccumulateCelestial(surface, surfacePosition, viewDirection,
                                 uSecondaryLighting.sunDirectionAndVisibility,
                                 uSecondaryLighting.sunRadiance.rgb * celestialMask, coneWidth, radiance) ||
        !rtgiAccumulateCelestial(surface, surfacePosition, viewDirection,
                                 uSecondaryLighting.moonDirectionAndVisibility,
                                 uSecondaryLighting.moonRadiance.rgb * celestialMask, coneWidth, radiance)) {
        return false;
    }
    vec3 cameraRelativeSurface = surfacePosition - pc.cameraPositionAndMaxDistance.xyz;
    if (!rtgiAccumulateWorldLights(surface, surfacePosition, cameraRelativeSurface, viewDirection,
                                   coneWidth, radiance)) {
        return false;
    }
    return rtgiAccumulateSkyAmbient(surface, surfacePosition, coneWidth, originSkyPrior, radiance);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = ivec2(pc.renderExtentAndBias.xy);
    if (texel.x >= extent.x || texel.y >= extent.y) {
        return;
    }

    float depth = texelFetch(uDepthTexture, texel, 0).r;
    if (depth >= 0.9999) {
        rtgiWriteResult(texel, vec3(0.0), 0.0, RTGI_TRACE_CLASS_SKY, 0u, 0u, 0u);
        return;
    }

    SurfaceMaterialAux materialAux = unpackGBufferMaterialAux(texelFetch(uMaterialAuxTexture, texel, 0));
    if (decodeTranslucentMask(materialAux.materialKind).isTranslucent) {
        rtgiWriteResult(texel, vec3(0.0), 0.0, RTGI_TRACE_CLASS_TRANSLUCENT, 0u, 0u, 0u);
        return;
    }

    vec2 screenUv = (vec2(texel) + 0.5) / pc.renderExtentAndBias.xy;
    vec3 worldPosition;
    vec3 adjacentWorldPositionX;
    vec3 adjacentWorldPositionY;
    vec2 pixelSize = 1.0 / pc.renderExtentAndBias.xy;
    // Reconstruct the screen-space derivatives with each neighbor's own
    // depth. Reusing the center depth flattens the neighborhood onto a
    // constant-depth plane, which bends the reconstructed geometric normal
    // toward the camera at grazing angles; ray origins biased along that
    // wrong normal start inside or behind the surface and leak.
    ivec2 adjacentTexelX = min(texel + ivec2(1, 0), extent - 1);
    ivec2 adjacentTexelY = min(texel + ivec2(0, 1), extent - 1);
    float depthX = texelFetch(uDepthTexture, adjacentTexelX, 0).r;
    float depthY = texelFetch(uDepthTexture, adjacentTexelY, 0).r;
    // Across sky or strong depth discontinuities the derivative no longer
    // describes the local surface; fall back to the center depth there so the
    // footprint stays bounded and the G-buffer normal takes over below.
    bool adjacentDepthValid = depthX < 0.9999 && depthY < 0.9999 &&
                              abs(depthX - depth) < 1.0e-3 && abs(depthY - depth) < 1.0e-3;
    float sampleDepthX = adjacentDepthValid ? depthX : depth;
    float sampleDepthY = adjacentDepthValid ? depthY : depth;
    if (!rtgiReconstructWorldPosition(screenUv, depth, worldPosition) ||
        !rtgiReconstructWorldPosition(screenUv + vec2(pixelSize.x, 0.0), sampleDepthX, adjacentWorldPositionX) ||
        !rtgiReconstructWorldPosition(screenUv + vec2(0.0, pixelSize.y), sampleDepthY, adjacentWorldPositionY)) {
        rtgiWriteResult(texel, vec3(0.0), 0.0, RTGI_TRACE_CLASS_NON_FINITE, 0u, 0u, 0u);
        return;
    }
    vec3 normal = unpackGBufferNormal(texelFetch(uNormalAoTexture, texel, 0));
    bool voxelPrimarySurface = materialKindId(materialAux.materialKind) <= MATERIAL_NETHER_ORE;
    vec3 geometricNormal = voxelPrimarySurface ? rtgiVoxelGeometricNormal(normal) : normal;
    vec3 reconstructedGeometricNormal = cross(adjacentWorldPositionX - worldPosition,
                                              adjacentWorldPositionY - worldPosition);
    float geometricNormalLengthSquared = dot(reconstructedGeometricNormal, reconstructedGeometricNormal);
    if (!rtgiFinite(worldPosition) || !rtgiFinite(normal) || !rtgiFinite(reconstructedGeometricNormal)) {
        rtgiWriteResult(texel, vec3(0.0), 0.0, RTGI_TRACE_CLASS_NON_FINITE, 0u, 0u, 0u);
        return;
    }
    normal = normalize(normal);
    // Voxel faces are axis-aligned even when LabPBR changes the shading normal.
    // Keep the ray origin and sampling hemisphere on that exact face plane so
    // animated samples cannot move through block corners or greedy-mesh seams.
    // Static meshes retain screen-space plane reconstruction because their
    // geometric normals are not restricted to the world axes.
    if (!voxelPrimarySurface && adjacentDepthValid && extent.x >= 2 && extent.y >= 2 &&
        geometricNormalLengthSquared > 1.0e-12) {
        vec3 candidateNormal = reconstructedGeometricNormal * inversesqrt(geometricNormalLengthSquared);
        candidateNormal = faceforward(candidateNormal, worldPosition - pc.cameraPositionAndMaxDistance.xyz,
                                      candidateNormal);
        if (dot(candidateNormal, normal) > 0.75) {
            geometricNormal = candidateNormal;
        }
    }
    if (dot(normal, geometricNormal) < 0.0) {
        normal = -normal;
    }
    float pixelWorldFootprint =
        max(length(adjacentWorldPositionX - worldPosition), length(adjacentWorldPositionY - worldPosition));
    if (!rtgiFinite(pixelWorldFootprint) || pixelWorldFootprint <= 0.0) {
        rtgiWriteResult(texel, vec3(0.0), 0.0, RTGI_TRACE_CLASS_NON_FINITE, 0u, 0u, 0u);
        return;
    }

    ivec2 noiseExtent = textureSize(uBlueNoiseTexture, 0);
    ivec2 noiseTexel = ivec2(uvec2(texel) % uvec2(noiseExtent));
    vec2 blueNoise = texelFetch(uBlueNoiseTexture, noiseTexel, 0).rg;
    vec2 sampleValue = pc.materialGeometryCounts.z != 0u
                           ? rtgiReferenceR2Sample(pc.frameMaskAndFlags.x, uvec2(texel))
                           : fract(blueNoise + rtgiPixelScrambledCranleyPattersonRotation(
                                                   pc.frameMaskAndFlags.x, uvec2(texel)));
    // A voxel normal map changes the BRDF but not the solid block boundary.
    // Sampling its perturbed hemisphere creates near-tangent directions that
    // can enter an adjacent face through a greedy-mesh seam. Use the exact
    // axis-aligned face for voxel transport; arbitrary static meshes retain
    // their smooth shading-normal distribution.
    vec3 samplingNormal = voxelPrimarySurface ? geometricNormal : normal;
    vec3 rayDirection = rtgiCosineHemisphereDirection(sampleValue, samplingNormal);
    if (dot(rayDirection, geometricNormal) < 0.0) {
        rayDirection = normalize(reflect(rayDirection, geometricNormal));
    }

    float originBias = rtgiOriginBias(worldPosition, geometricNormal, rayDirection);
    vec3 rayOrigin = rtgiOffsetSurfaceOrigin(worldPosition, geometricNormal, rayDirection, originBias);
    float rayMinimum = max(originBias * 0.25, 1.0e-4);
    float primarySurfaceDistance = length(worldPosition - pc.cameraPositionAndMaxDistance.xyz);

    rayQueryEXT query;
    rayQueryInitializeEXT(query, globalBindlessSceneTlas, gl_RayFlagsTerminateOnFirstHitEXT,
                          pc.frameMaskAndFlags.y, rayOrigin, rayMinimum, rayDirection,
                          pc.cameraPositionAndMaxDistance.w);
    uint candidateCount = 0u;
    uint confirmedCount = 0u;
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) != gl_RayQueryCandidateIntersectionTriangleEXT) {
            continue;
        }
        candidateCount = min(candidateCount + 1u, RTGI_TRACE_VALIDATION_CANDIDATE_MASK);
        float candidateDistance = rayQueryGetIntersectionTEXT(query, false);
        float coneWidth = rtgiConeWidth(pixelWorldFootprint, candidateDistance, primarySurfaceDistance);
        float sampledOpacity;
        float sampledLod;
        uint stableMaterialId;
        uint stableGeometryId;
        if (rtgiCandidateAlphaPasses(
                rayQueryGetIntersectionInstanceCustomIndexEXT(query, false),
                rayQueryGetIntersectionGeometryIndexEXT(query, false),
                rayQueryGetIntersectionPrimitiveIndexEXT(query, false),
                rayQueryGetIntersectionBarycentricsEXT(query, false), coneWidth, sampledOpacity,
                sampledLod, stableMaterialId, stableGeometryId)) {
            rayQueryConfirmIntersectionEXT(query);
            confirmedCount = min(confirmedCount + 1u, RTGI_TRACE_VALIDATION_CONFIRMED_MASK);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        float hitDistance = rayQueryGetIntersectionTEXT(query, true);
        float coneWidth = rtgiConeWidth(pixelWorldFootprint, hitDistance, primarySurfaceDistance);
        uint customIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
        uint geometryIndex = rayQueryGetIntersectionGeometryIndexEXT(query, true);
        uint primitiveIndex = rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
        RtgiSecondarySurface surface;
        uint hitIdentityHash = 0u;
        bool surfaceValid = false;
        if (staticMeshRayQueryInstancePresent(customIndex, pc.frameMaskAndFlags.z)) {
            StaticMeshRayQuerySurface staticSurface;
            surfaceValid = staticMeshRayQueryCommittedSurface(
                customIndex, geometryIndex, primitiveIndex, barycentrics, coneWidth, rayDirection,
                uSecondaryLighting.traceAndEmissionScales.z, pc.frameMaskAndFlags.z,
                pc.materialGeometryCounts.x, pc.materialGeometryCounts.y, staticSurface);
            if (surfaceValid) {
                surface.albedo = staticSurface.albedo;
                surface.normal = staticSurface.normal;
                surface.geometricNormal = staticSurface.geometricNormal;
                surface.emission = staticSurface.emission;
                surface.specularF0 = staticSurface.specularF0;
                surface.specularF90 = staticSurface.specularF90;
                surface.perceptualRoughness = staticSurface.perceptualRoughness;
                surface.metalness = staticSurface.metalness;
                surface.ao = staticSurface.ao;
                surface.skyVisibility = 1.0;
                surface.blockLight = 0.0;
                hitIdentityHash = rtgiStableHitIdentityHash(staticSurface.stableMaterialId,
                                                            staticSurface.stableGeometryId);
            }
        } else if (customIndex < pc.frameMaskAndFlags.z) {
            TerrainRayQuerySurface terrainSurface;
            TerrainRayTracingGpuInstance terrainInstance = uTerrainHitData.instances[customIndex];
            hitIdentityHash = rtgiTerrainHitIdentityHash(terrainInstance.revisionLow, terrainInstance.revisionHigh,
                                                          terrainInstance.vertexAddressWords);
            surfaceValid = terrainRayQueryCommittedSurface(
                terrainInstance, geometryIndex, primitiveIndex, barycentrics,
                coneWidth, pc.renderExtentAndBias.w, rayDirection,
                (uSecondaryLighting.flags.x & RTGI_SECONDARY_LIGHTING_TERRAIN_NORMAL_MAP_BIT) != 0u,
                (uSecondaryLighting.flags.x & RTGI_SECONDARY_LIGHTING_TERRAIN_SPECULAR_MAP_BIT) != 0u,
                uSecondaryLighting.traceAndEmissionScales.y, uTerrainAlbedo, uTerrainNormal,
                uTerrainSpecular, uGrassColormap, uFoliageColormap, terrainSurface);
            if (surfaceValid) {
                surface.albedo = terrainSurface.albedo;
                surface.normal = terrainSurface.normal;
                surface.geometricNormal = terrainSurface.geometricNormal;
                surface.emission = terrainSurface.emission;
                surface.specularF0 = terrainSurface.specularF0;
                surface.specularF90 = terrainSurface.specularF90;
                surface.perceptualRoughness = terrainSurface.perceptualRoughness;
                surface.metalness = terrainSurface.metalness;
                surface.ao = terrainSurface.ao;
                surface.skyVisibility = terrainSurface.skyVisibility;
                surface.blockLight = terrainSurface.blockLight;
            }
        }
        vec3 radiance;
        vec3 surfacePosition = rayOrigin + rayDirection * hitDistance;
        float originSkyLight = clamp(texelFetch(uVoxelLightTexture, texel, 0).r, 0.0, 1.0);
        float originSkyPrior = originSkyLight * originSkyLight * originSkyLight;
        if (!surfaceValid ||
            !rtgiShadeSecondarySurface(surface, surfacePosition, rayDirection, coneWidth, originSkyPrior,
                                       radiance)) {
            rtgiWriteResult(texel, vec3(0.0), 0.0, RTGI_TRACE_CLASS_NON_FINITE, candidateCount,
                            confirmedCount, 0u);
            return;
        }
        rtgiWriteResult(texel, radiance, hitDistance, RTGI_TRACE_CLASS_HIT, candidateCount,
                        confirmedCount, hitIdentityHash);
        return;
    }

    float skyVisibility = 0.0;
    if (!rtgiPrimarySkyVisibility(worldPosition, geometricNormal, pixelWorldFootprint, texel, skyVisibility)) {
        rtgiWriteResult(texel, vec3(0.0), RTGI_NRD_FP16_MAX, RTGI_TRACE_CLASS_MISS, candidateCount,
                        confirmedCount, 0u);
        return;
    }
    vec3 missRadiance = rtgiSuppressSolarSkyLobe(sampleSkyRadiance(uSkyCapture, rayDirection), rayDirection) *
                        skyVisibility;
    rtgiWriteResult(texel, missRadiance, RTGI_NRD_FP16_MAX, RTGI_TRACE_CLASS_MISS, candidateCount,
                    confirmedCount, 0u);
}
