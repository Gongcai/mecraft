#version 450 core
#include "cluster_build_contract.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer ClusterRecordBuffer {
    ClusterRecord uClusterRecords[];
};
layout(binding = 1, std430) readonly buffer ClusterCursorBuffer {
    uint uClusterCursors[];
};
layout(binding = 2, std430) buffer ClusterStatsBuffer {
    uint uClusterStats[];
};

layout(push_constant) uniform RhiPushConstants {
    // x: cluster count; y: compact index capacity.
    uvec4 uCountsAndCapacity;
};

void main() {
    const uint clusterIndex = gl_GlobalInvocationID.x;
    if (clusterIndex >= uCountsAndCapacity.x) {
        return;
    }
    const ClusterRecord record = uClusterRecords[clusterIndex];
    if (uClusterCursors[clusterIndex] != record.count ||
        record.offset > uCountsAndCapacity.y ||
        record.count > uCountsAndCapacity.y -
            min(record.offset, uCountsAndCapacity.y)) {
        atomicOr(uClusterStats[CLUSTER_STATS_BUILD_ERROR],
                 CLUSTER_BUILD_ERROR_CURSOR_MISMATCH);
    }
}
