#version 450 core
#include "cluster_build_contract.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer ClusterCountBuffer {
    uint uClusterCounts[];
};
layout(binding = 1, std430) readonly buffer ClusterOffsetBuffer {
    uint uClusterOffsets[];
};
layout(binding = 2, std430) buffer ClusterRecordBuffer {
    ClusterRecord uClusterRecords[];
};
layout(binding = 3, std430) buffer ClusterStatsBuffer {
    uint uClusterStats[];
};

layout(push_constant) uniform RhiPushConstants {
    // x: cluster count; y: compact index capacity; z: light count.
    uvec4 uCountsAndCapacity;
};

void main() {
    const uint clusterIndex = gl_GlobalInvocationID.x;
    if (clusterIndex >= uCountsAndCapacity.x) {
        return;
    }
    const uint offset = uClusterOffsets[clusterIndex];
    const uint count = uClusterCounts[clusterIndex];
    uClusterRecords[clusterIndex].offset = offset;
    uClusterRecords[clusterIndex].count = count;
    atomicAdd(uClusterStats[CLUSTER_STATS_TOTAL_INDEX_COUNT], count);
    atomicMax(uClusterStats[CLUSTER_STATS_MAX_LIGHTS_PER_CLUSTER], count);
    if (count != 0u) {
        atomicAdd(uClusterStats[CLUSTER_STATS_NON_EMPTY_CLUSTER_COUNT], 1u);
    }
    if (offset > uCountsAndCapacity.y ||
        count > uCountsAndCapacity.y - min(offset, uCountsAndCapacity.y)) {
        atomicOr(uClusterStats[CLUSTER_STATS_BUILD_ERROR],
                 CLUSTER_BUILD_ERROR_PREFIX_CAPACITY);
    }
}
