#version 450 core
#include "cluster_build_contract.glsl"
#include "cluster_sphere_intersection.glsl"

layout(local_size_x = CLUSTER_COVERAGE_WORKGROUP_SIZE,
       local_size_y = 1,
       local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer LightBoundsBuffer {
    ClusterLightBounds uLightBounds[];
};
layout(binding = 1, std430) buffer ClusterCountBuffer {
    uint uClusterCounts[];
};

layout(push_constant) uniform RhiPushConstants {
    mat4 uInverseProjection;
    // xyz: cluster grid dimensions; w: light count.
    uvec4 uGridAndLightCount;
    // x/y: near/far depth; z/w: logarithmic slice scale/bias.
    vec4 uDepthParameters;
};

void main() {
    const uint boundsIndex = gl_WorkGroupID.x;
    if (boundsIndex >= uGridAndLightCount.w) {
        return;
    }
    const ClusterLightBounds bounds = uLightBounds[boundsIndex];
    if (bounds.minCluster.w == 0u) {
        return;
    }
    const uint depthSlice = bounds.minCluster.z + gl_WorkGroupID.y;
    if (depthSlice > bounds.maxCluster.z) {
        return;
    }
    const uvec2 minimumCluster = bounds.minCluster.xy;
    const uvec2 coverageExtent =
        bounds.maxCluster.xy - minimumCluster + uvec2(1u);
    const uint coverageCount = coverageExtent.x * coverageExtent.y;
    const uvec3 gridSize = uGridAndLightCount.xyz;
    for (uint coverageIndex = gl_LocalInvocationID.x;
         coverageIndex < coverageCount;
         coverageIndex += CLUSTER_COVERAGE_WORKGROUP_SIZE) {
        const uvec3 cluster = clusteredLightCoverageCoordinate(
            coverageIndex, minimumCluster, coverageExtent, depthSlice);
        const ClusterFrustumCorners frustum = buildClusterFrustumCorners(
            uInverseProjection, uDepthParameters, cluster, gridSize);
        if (!clusterSphereIntersectsCluster(bounds.viewSphere, frustum)) {
            continue;
        }
        const uint clusterIndex = clusteredLightClusterIndex(
            cluster, gridSize);
        atomicAdd(uClusterCounts[clusterIndex], 1u);
    }
}
