#version 450 core

#include "gbuffer_contract.glsl"
#include "rhi_screen_coordinates.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D uDepthTexture;
layout(binding = 1) uniform sampler2D uNormalAoTexture;
layout(binding = 2) uniform sampler2D uMaterialTexture;
layout(binding = 3) uniform sampler2D uVelocityTexture;
layout(binding = 4, rgba16f) uniform writeonly image2D uMotion;
layout(binding = 5, rgb10_a2) uniform writeonly image2D uNormalRoughness;
layout(binding = 6, r32f) uniform writeonly image2D uViewZ;
layout(binding = 7, r8) uniform writeonly image2D uReprojectionCoverage;
layout(binding = 8, rgba16f) uniform writeonly image2D uLeakageNormal;
layout(binding = 9, rgba16f) uniform writeonly image2D uLeakageViewZ;

layout(push_constant) uniform NrdGuidePrepPushConstants {
    mat4 inverseProjection;
    mat4 currentClipToPreviousView;
    vec4 renderExtentInvalidViewZAndHistory;
    vec4 flags;
} pc;

bool nrdGuideFinite(vec4 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

bool nrdGuideReconstructPositiveViewZ(mat4 inverseProjection, vec2 screenUv, float depth, out float positiveViewZ) {
    positiveViewZ = 0.0;
    if (depth >= 0.999999) {
        return false;
    }

    vec2 clipUv = rhiScreenUvToClipUv(screenUv);
    vec4 viewPosition = inverseProjection * vec4(clipUv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    if (!nrdGuideFinite(viewPosition) || abs(viewPosition.w) <= 1.0e-7) {
        return false;
    }

    viewPosition /= viewPosition.w;
    if (!nrdGuideFinite(viewPosition) || viewPosition.z >= -1.0e-7) {
        return false;
    }
    positiveViewZ = -viewPosition.z;
    return nrdGuideFinite(vec4(positiveViewZ, 0.0, 0.0, 0.0));
}

float nrdGuidePositiveViewZ(mat4 inverseProjection, vec2 screenUv, float depth, float invalidViewZ) {
    float positiveViewZ;
    return nrdGuideReconstructPositiveViewZ(inverseProjection, screenUv, depth, positiveViewZ) ? positiveViewZ
                                                                                               : invalidViewZ;
}

float nrdGuideMaterialId(SurfaceMaterial material, float roughness) {
    if (material.emission > 0.01) {
        return 3.0;
    }
    if (material.sss > 0.01) {
        return 2.0;
    }
    if (roughness < 0.35) {
        return 1.0;
    }
    return 0.0;
}

vec4 nrdGuidePackNormalRoughness(vec3 normal, float roughness, float materialId) {
    normal /= abs(normal.x) + abs(normal.y) + abs(normal.z);

    vec4 packed;
    packed.y = normal.y * 0.5 + 0.5;
    packed.x = normal.x * 0.5 + packed.y;
    packed.y -= normal.x * 0.5;

    roughness = max(clamp(roughness, 0.0, 1.0), 1.5 / 512.0);
    float signedRoughness = normal.z < 0.0 ? -roughness : roughness;
    packed.z = signedRoughness * 0.5 + 0.5;
    packed.w = clamp(materialId / 3.0, 0.0, 1.0);
    return packed;
}

vec3 nrdGuideVoxelGeometricNormal(vec3 shadingNormal) {
    vec3 magnitude = abs(shadingNormal);
    if (magnitude.x >= magnitude.y && magnitude.x >= magnitude.z) {
        return vec3(shadingNormal.x < 0.0 ? -1.0 : 1.0, 0.0, 0.0);
    }
    if (magnitude.y >= magnitude.z) {
        return vec3(0.0, shadingNormal.y < 0.0 ? -1.0 : 1.0, 0.0);
    }
    return vec3(0.0, 0.0, shadingNormal.z < 0.0 ? -1.0 : 1.0);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = ivec2(pc.renderExtentInvalidViewZAndHistory.xy);
    if (texel.x >= extent.x || texel.y >= extent.y) {
        return;
    }

    float depth = texelFetch(uDepthTexture, texel, 0).r;
    vec2 screenUv = (vec2(texel) + 0.5) / vec2(extent);
    float invalidViewZ = pc.renderExtentInvalidViewZAndHistory.z;
    float currentPositiveViewZ = nrdGuidePositiveViewZ(pc.inverseProjection, screenUv, depth, invalidViewZ);

    vec3 normal = unpackGBufferNormal(texelFetch(uNormalAoTexture, texel, 0));
    SurfaceMaterial material = unpackGBufferMaterial(texelFetch(uMaterialTexture, texel, 0));
    float roughness = linearMaterialRoughness(material);
    float materialId = nrdGuideMaterialId(material, roughness);
    vec2 motion = -texelFetch(uVelocityTexture, texel, 0).rg;
    float motionViewZ = 0.0;
    float reprojectionCoverage = 0.0;
    const bool historyValid = pc.renderExtentInvalidViewZAndHistory.w > 0.5;
    if (historyValid && currentPositiveViewZ < invalidViewZ && nrdGuideFinite(vec4(motion, 0.0, 0.0))) {
        float previousPositiveViewZ;
        if (nrdGuideReconstructPositiveViewZ(pc.currentClipToPreviousView, screenUv, depth,
                                              previousPositiveViewZ) && previousPositiveViewZ < invalidViewZ) {
            // The current depth sample identifies the current world point. Projecting that same point into the
            // previous view avoids sampling an unrelated surface at a disoccluded or newly visible history pixel.
            motionViewZ = previousPositiveViewZ - currentPositiveViewZ;
            const vec2 previousUv = screenUv + motion;
            const bool previousUvInside = all(greaterThanEqual(previousUv, vec2(0.0))) &&
                                          all(lessThan(previousUv, vec2(1.0)));
            reprojectionCoverage = previousUvInside ? 1.0 : 0.0;
        }
    }

    imageStore(uMotion, texel, vec4(motion, motionViewZ, 0.0));
    imageStore(uNormalRoughness, texel, nrdGuidePackNormalRoughness(normal, roughness, materialId));
    // NRD consumes signed view-space Z and infers handedness from the
    // projection matrix; this renderer is right-handed, so the visible
    // half-space is negative Z. Publishing |z| mirrors every reconstructed
    // world position while the camera delta stays in real space, which breaks
    // reprojection during motion.
    float signedViewZ = currentPositiveViewZ < invalidViewZ ? -currentPositiveViewZ : -invalidViewZ;
    imageStore(uViewZ, texel, vec4(signedViewZ, 0.0, 0.0, 0.0));
    vec3 leakageNormal = pc.flags.x > 0.5 ? nrdGuideVoxelGeometricNormal(normal) : normal;
    imageStore(uLeakageNormal, texel, vec4(leakageNormal * 0.5 + 0.5, 1.0));
    imageStore(uLeakageViewZ, texel, vec4(currentPositiveViewZ, currentPositiveViewZ, currentPositiveViewZ, 1.0));

    // This mask is a current-frame diagnostic of whether the surface maps
    // inside the previous viewport. It is not NRD history confidence, whose
    // contract requires a separately traced previous-frame lighting gradient.
    imageStore(uReprojectionCoverage, texel, vec4(reprojectionCoverage, 0.0, 0.0, 0.0));
}
