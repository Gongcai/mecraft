#version 450 core

// Builds one mip of the Hi-Z occlusion pyramid. The pyramid stores the
// FARTHEST (maximum) depth of each footprint so an occlusion test that finds
// an object's nearest depth beyond the sampled value can reject it
// conservatively with standard 0-near/1-far depth.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D uSourceTex;
layout(binding = 1, r32f) uniform writeonly image2D uDestMip;

layout(push_constant) uniform RhiPushConstants {
    // x, y: destination mip extent; z: 1 when copying the depth buffer into
    // mip 0 (1:1), 0 for the 2x2 max-reduction of the previous mip.
    ivec4 uParams;
};

void main() {
    const ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= uParams.x || texel.y >= uParams.y) {
        return;
    }
    if (uParams.z != 0) {
        imageStore(uDestMip, texel, vec4(texelFetch(uSourceTex, texel, 0).r));
        return;
    }
    // 2x2 max gather. Odd source dimensions leave a final row/column that
    // no 2x2 footprint covers (floor halving); the edge texels absorb those
    // extra samples so no far value is ever dropped from the pyramid.
    const ivec2 srcSize = textureSize(uSourceTex, 0);
    const ivec2 srcBase = texel * 2;
    const float d0 = texelFetch(uSourceTex, min(srcBase, srcSize - 1), 0).r;
    const float d1 = texelFetch(uSourceTex,
                                min(srcBase + ivec2(1, 0), srcSize - 1), 0).r;
    const float d2 = texelFetch(uSourceTex,
                                min(srcBase + ivec2(0, 1), srcSize - 1), 0).r;
    const float d3 = texelFetch(uSourceTex,
                                min(srcBase + ivec2(1, 1), srcSize - 1), 0).r;
    float farthest = max(max(d0, d1), max(d2, d3));
    const bool tailX = (srcSize.x & 1) != 0 && texel.x == uParams.x - 1;
    const bool tailY = (srcSize.y & 1) != 0 && texel.y == uParams.y - 1;
    if (tailX) {
        const float e0 = texelFetch(uSourceTex,
                                    min(srcBase + ivec2(2, 0), srcSize - 1), 0).r;
        const float e1 = texelFetch(uSourceTex,
                                    min(srcBase + ivec2(2, 1), srcSize - 1), 0).r;
        farthest = max(farthest, max(e0, e1));
    }
    if (tailY) {
        const float e2 = texelFetch(uSourceTex,
                                    min(srcBase + ivec2(0, 2), srcSize - 1), 0).r;
        const float e3 = texelFetch(uSourceTex,
                                    min(srcBase + ivec2(1, 2), srcSize - 1), 0).r;
        farthest = max(farthest, max(e2, e3));
    }
    if (tailX && tailY) {
        farthest = max(farthest,
                       texelFetch(uSourceTex,
                                  min(srcBase + ivec2(2, 2), srcSize - 1), 0).r);
    }
    imageStore(uDestMip, texel, vec4(farthest));
}
