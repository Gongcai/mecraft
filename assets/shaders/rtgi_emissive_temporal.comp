#version 460 core

#include "rtgi_nrd_signal.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D uCurrentEmissiveDirectRadiance;
layout(set = 0, binding = 1) uniform sampler2D uMotion;
layout(set = 0, binding = 2) uniform sampler2D uReprojectionCoverage;
layout(set = 0, binding = 3) uniform sampler2D uNormalRoughness;
layout(set = 0, binding = 4) uniform sampler2D uViewZ;
layout(set = 0, binding = 5) uniform sampler2D uPreviousEmissiveHistory;
layout(set = 0, binding = 6) uniform sampler2D uPreviousNormalViewZHistory;
layout(set = 0, binding = 7, rgba32f) uniform writeonly image2D uOutputEmissiveHistory;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D uOutputNormalViewZHistory;

layout(push_constant) uniform RtgiEmissiveTemporalPushConstants {
    vec4 renderExtentHistoryAndExposure;
    vec4 rejectionParameters;
} pc;

const float RTGI_EMISSIVE_TEMPORAL_MAX_HISTORY = 32.0;
const float RTGI_EMISSIVE_TEMPORAL_MIN_VIEW_Z = 1.0e-4;

bool rtgiEmissiveTemporalFinite(vec4 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

vec3 rtgiEmissiveTemporalDecodeNormal(vec3 packedNormalRoughness) {
    float signedRoughness = packedNormalRoughness.z * 2.0 - 1.0;
    vec3 normal;
    normal.x = packedNormalRoughness.x - packedNormalRoughness.y;
    normal.y = packedNormalRoughness.x + packedNormalRoughness.y - 1.0;
    normal.z = (signedRoughness < 0.0 ? -1.0 : 1.0) *
               (1.0 - abs(normal.x) - abs(normal.y));
    return normalize(normal);
}

bool rtgiEmissiveTemporalCurrentGuide(ivec2 texel, out vec3 normal, out float positiveViewZ) {
    vec3 packedNormalRoughness = texelFetch(uNormalRoughness, texel, 0).rgb;
    normal = rtgiEmissiveTemporalDecodeNormal(packedNormalRoughness);
    positiveViewZ = -texelFetch(uViewZ, texel, 0).r;
    return rtgiEmissiveTemporalFinite(vec4(normal, positiveViewZ)) &&
           dot(normal, normal) >= 0.99 && positiveViewZ > RTGI_EMISSIVE_TEMPORAL_MIN_VIEW_Z &&
           positiveViewZ < pc.rejectionParameters.y;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = ivec2(pc.renderExtentHistoryAndExposure.xy);
    if (texel.x >= extent.x || texel.y >= extent.y) {
        return;
    }

    vec4 currentSignal = texelFetch(uCurrentEmissiveDirectRadiance, texel, 0);
    vec3 currentNormal;
    float currentPositiveViewZ;
    bool currentGuideValid = rtgiEmissiveTemporalCurrentGuide(texel, currentNormal, currentPositiveViewZ);
    vec4 currentGuide = currentGuideValid ? vec4(currentNormal, currentPositiveViewZ) : vec4(0.0);

    vec3 filteredRadiance = currentSignal.rgb;
    float filteredHistoryCount = 1.0;
    bool historyAccepted = pc.renderExtentHistoryAndExposure.z > 0.5 && currentGuideValid &&
                           rtgiEmissiveTemporalFinite(currentSignal) &&
                           all(greaterThanEqual(currentSignal.rgb, vec3(0.0))) &&
                           texelFetch(uReprojectionCoverage, texel, 0).r > 0.5;

    vec4 motion = texelFetch(uMotion, texel, 0);
    historyAccepted = historyAccepted && rtgiEmissiveTemporalFinite(motion);
    vec2 screenUv = (vec2(texel) + 0.5) / vec2(extent);
    vec2 previousUv = screenUv + motion.xy;
    historyAccepted = historyAccepted && all(greaterThanEqual(previousUv, vec2(0.0))) &&
                      all(lessThan(previousUv, vec2(1.0)));

    if (historyAccepted) {
        ivec2 previousTexel = ivec2(previousUv * vec2(extent));
        vec4 previousSignal = texelFetch(uPreviousEmissiveHistory, previousTexel, 0);
        vec4 previousGuide = texelFetch(uPreviousNormalViewZHistory, previousTexel, 0);
        float expectedPreviousPositiveViewZ = currentPositiveViewZ + motion.z;
        float relativeDepthScale = max(max(abs(expectedPreviousPositiveViewZ), abs(previousGuide.w)),
                                       RTGI_EMISSIVE_TEMPORAL_MIN_VIEW_Z);
        float relativeDepthError = abs(previousGuide.w - expectedPreviousPositiveViewZ) / relativeDepthScale;
        bool previousHistoryValid = rtgiEmissiveTemporalFinite(previousSignal) &&
                                    rtgiEmissiveTemporalFinite(previousGuide) &&
                                    all(greaterThanEqual(previousSignal.rgb, vec3(0.0))) &&
                                    previousSignal.a >= 1.0 &&
                                    previousSignal.a <= RTGI_EMISSIVE_TEMPORAL_MAX_HISTORY &&
                                    expectedPreviousPositiveViewZ > RTGI_EMISSIVE_TEMPORAL_MIN_VIEW_Z &&
                                    expectedPreviousPositiveViewZ < pc.rejectionParameters.y &&
                                    previousGuide.w > RTGI_EMISSIVE_TEMPORAL_MIN_VIEW_Z &&
                                    relativeDepthError <= pc.rejectionParameters.x &&
                                    dot(currentNormal, previousGuide.xyz) >= pc.rejectionParameters.z;
        if (previousHistoryValid) {
            filteredHistoryCount = min(previousSignal.a + 1.0, RTGI_EMISSIVE_TEMPORAL_MAX_HISTORY);
            float currentFrameWeight = 1.0 / filteredHistoryCount;
            vec3 exposureAdjustedHistory = previousSignal.rgb * pc.renderExtentHistoryAndExposure.w;
            filteredRadiance = mix(exposureAdjustedHistory, currentSignal.rgb, currentFrameWeight);
        }
    }

    filteredRadiance = min(filteredRadiance, vec3(RTGI_NRD_FP16_MAX));
    imageStore(uOutputEmissiveHistory, texel, vec4(filteredRadiance, filteredHistoryCount));
    imageStore(uOutputNormalViewZHistory, texel, currentGuide);
}
