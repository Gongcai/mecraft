#version 450 core

#include "../../assets/shaders/gpu_scene_contract.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer GpuSceneInstanceBuffer {
    GpuSceneInstance instances[];
};

layout(std430, set = 0, binding = 1) readonly buffer GpuSceneGeometryBuffer {
    GpuSceneGeometry geometries[];
};

layout(std430, set = 0, binding = 2) writeonly buffer GpuSceneContractOutputBuffer {
    vec4 outputValues[];
};

void main() {
    GpuSceneInstance instance = instances[0];
    GpuSceneGeometry geometry = geometries[0];
    vec3 transformedOrigin = gpuSceneTransformPoint(instance.worldFromObject, vec3(0.0));
    outputValues[0] = vec4(transformedOrigin + geometry.localBoundsMin.xyz, instance.worldBoundsCenterAndRadius.w);
}
